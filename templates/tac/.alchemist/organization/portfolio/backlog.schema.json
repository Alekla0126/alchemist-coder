{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tac:profitability:v1",
  "title":"TAC profitability initiative registry; structure is not execution authorization",
  "type":"object","additionalProperties":false,
  "required":["version","synthetic","scope","coordination","policy","apps","initiatives","learning","readiness"],
  "properties":{
    "version":{"const":"tac.profitability.v1"},"synthetic":{"type":"boolean"},
    "scope":{"type":"object","additionalProperties":false,"required":["orgRef","brandRef"],"properties":{"orgRef":{"$ref":"#/$defs/ref"},"brandRef":{"$ref":"#/$defs/ref"}}},
    "coordination":{"type":"object","additionalProperties":false,"required":["role","finance","productMonetization","marketing","sales","analytics"],"properties":{"role":{"const":"coordinator"},"finance":{"const":"finance"},"productMonetization":{"const":"planner"},"marketing":{"const":"strategy"},"sales":{"const":"sales"},"analytics":{"const":"analyst"}}},
    "policy":{"type":"object","additionalProperties":false,"required":["primaryOutcome","computePriority","newWork","firstExperimentLimit","dispatch","executable"],"properties":{"primaryOutcome":{"const":"comparable_net_contribution"},"computePriority":{"const":"majority_existing_verified_business"},"newWork":{"const":"defer_unless_documented_deadline_or_revenue_blocker"},"firstExperimentLimit":{"const":1},"dispatch":{"const":"existing_org_queue_only"},"executable":{"const":false}}},
    "apps":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/app"}},
    "initiatives":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/initiative"}},
    "learning":{"type":"object","additionalProperties":false,"required":["version","retentionPolicyRef","records"],"properties":{"version":{"const":"tac.learning.v1"},"retentionPolicyRef":{"$ref":"#/$defs/nullableRef"},"records":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/lesson"}}},"allOf":[{"if":{"properties":{"records":{"contains":{"properties":{"state":{"const":"reviewed"}},"required":["state"]}}}},"then":{"properties":{"retentionPolicyRef":{"$ref":"#/$defs/ref"}}}}]},
    "readiness":{"type":"object","additionalProperties":false,"required":["phase","selectedAppRef","commercialExecutionAuthorized","knownComputeShare"],"properties":{"phase":{"enum":["reconcile_private_sources","select_one_app","prepare_one_experiment"]},"selectedAppRef":{"$ref":"#/$defs/nullableRef"},"commercialExecutionAuthorized":{"const":false},"knownComputeShare":{"type":["number","null"],"minimum":0,"maximum":1}}}
  },
  "allOf":[
    {"if":{"properties":{"apps":{"contains":{"properties":{"economics":{"properties":{"status":{"const":"unknown"}},"required":["status"]}},"required":["economics"]}}}},"then":{"properties":{"readiness":{"properties":{"phase":{"const":"reconcile_private_sources"},"selectedAppRef":{"type":"null"}}},"initiatives":{"items":{"properties":{"metric":{"properties":{"targetDeltaMinor":{"type":"null"}}},"status":{"not":{"const":"running"}}}}}}}},
    {"if":{"properties":{"initiatives":{"contains":{"properties":{"approvedCost":{"properties":{"computeMinutes":{"type":"null"}},"required":["computeMinutes"]}},"required":["approvedCost"]}}}},"then":{"properties":{"readiness":{"properties":{"knownComputeShare":{"type":"null"}}}}}}
  ],
  "$defs":{
    "ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "nullableRef":{"anyOf":[{"$ref":"#/$defs/ref"},{"type":"null"}]},
    "refs":{"type":"array","maxItems":30,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},
    "money":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
    "nullableMoney":{"anyOf":[{"$ref":"#/$defs/money"},{"type":"null"}]},
    "nullableDate":{"type":["string","null"],"format":"date"},
    "nullableTime":{"type":["string","null"],"format":"date-time"},
    "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "nullableCurrency":{"anyOf":[{"$ref":"#/$defs/currency"},{"type":"null"}]},
    "text":{"type":"string","minLength":12,"maxLength":1500},
    "economics":{
      "type":"object","additionalProperties":false,"required":["status","currency","periodStart","periodEnd","basisRef","netRevenueMinor","attributableCostMinor","sourceRefs"],
      "properties":{"status":{"enum":["unknown","verified"]},"currency":{"$ref":"#/$defs/nullableCurrency"},"periodStart":{"$ref":"#/$defs/nullableDate"},"periodEnd":{"$ref":"#/$defs/nullableDate"},"basisRef":{"$ref":"#/$defs/nullableRef"},"netRevenueMinor":{"$ref":"#/$defs/nullableMoney"},"attributableCostMinor":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"sourceRefs":{"$ref":"#/$defs/refs"}},
      "allOf":[{"if":{"properties":{"status":{"const":"unknown"}}},"then":{"properties":{"currency":{"type":"null"},"periodStart":{"type":"null"},"periodEnd":{"type":"null"},"basisRef":{"type":"null"},"netRevenueMinor":{"type":"null"},"attributableCostMinor":{"type":"null"},"sourceRefs":{"maxItems":0}}},"else":{"properties":{"currency":{"$ref":"#/$defs/currency"},"periodStart":{"type":"string","format":"date"},"periodEnd":{"type":"string","format":"date"},"basisRef":{"$ref":"#/$defs/ref"},"netRevenueMinor":{"$ref":"#/$defs/money"},"attributableCostMinor":{"type":"integer","minimum":0,"maximum":9007199254740991},"sourceRefs":{"minItems":1}}}}]
    },
    "app":{"type":"object","additionalProperties":false,"required":["appRef","stage","demandStatus","demandSourceRefs","economics"],"properties":{"appRef":{"$ref":"#/$defs/ref"},"stage":{"enum":["existing","new"]},"demandStatus":{"enum":["unknown","verified"]},"demandSourceRefs":{"$ref":"#/$defs/refs"},"economics":{"$ref":"#/$defs/economics"}},"allOf":[{"if":{"properties":{"demandStatus":{"const":"verified"}}},"then":{"properties":{"demandSourceRefs":{"minItems":1}}}}]},
    "cost":{"type":"object","additionalProperties":false,"required":["approvalRef","cashCeilingMinor","currency","computeMinutes"],"properties":{"approvalRef":{"$ref":"#/$defs/nullableRef"},"cashCeilingMinor":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"currency":{"$ref":"#/$defs/nullableCurrency"},"computeMinutes":{"type":["integer","null"],"minimum":0,"maximum":525600}}},
    "metric":{"type":"object","additionalProperties":false,"required":["name","sourceRef","windowStart","windowEnd","targetDeltaMinor"],"properties":{"name":{"const":"net_contribution"},"sourceRef":{"$ref":"#/$defs/nullableRef"},"windowStart":{"$ref":"#/$defs/nullableDate"},"windowEnd":{"$ref":"#/$defs/nullableDate"},"targetDeltaMinor":{"$ref":"#/$defs/nullableMoney"}}},
    "result":{"type":"object","additionalProperties":false,"required":["state","sourceRefs","deltaMinor","costMinor","costSourceRef","reviewReceiptRef","decision"],"properties":{"state":{"enum":["not_run","observed","reviewed"]},"sourceRefs":{"$ref":"#/$defs/refs"},"deltaMinor":{"$ref":"#/$defs/nullableMoney"},"costMinor":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"costSourceRef":{"$ref":"#/$defs/nullableRef"},"reviewReceiptRef":{"$ref":"#/$defs/nullableRef"},"decision":{"enum":["pending","stop","iterate","propose_scale"]}},"allOf":[{"if":{"properties":{"state":{"const":"not_run"}}},"then":{"properties":{"sourceRefs":{"maxItems":0},"deltaMinor":{"type":"null"},"costMinor":{"type":"null"},"costSourceRef":{"type":"null"},"reviewReceiptRef":{"type":"null"},"decision":{"const":"pending"}}}},{"if":{"properties":{"state":{"const":"reviewed"}}},"then":{"properties":{"sourceRefs":{"minItems":1},"reviewReceiptRef":{"$ref":"#/$defs/ref"},"decision":{"not":{"const":"pending"}}}}},{"if":{"properties":{"costMinor":{"type":"integer"}}},"then":{"properties":{"costSourceRef":{"$ref":"#/$defs/ref"}}}}]},
    "links":{"type":"object","additionalProperties":false,"required":["boardCardRef","queueJobRef","checkpointRef","parentResultRef"],"properties":{"boardCardRef":{"$ref":"#/$defs/nullableRef"},"queueJobRef":{"$ref":"#/$defs/nullableRef"},"checkpointRef":{"$ref":"#/$defs/nullableRef"},"parentResultRef":{"$ref":"#/$defs/nullableRef"}}},
    "exception":{"type":"object","additionalProperties":false,"required":["kind","sourceRefs"],"properties":{"kind":{"enum":["none","deadline","revenue_blocker"]},"sourceRefs":{"$ref":"#/$defs/refs"}},"allOf":[{"if":{"properties":{"kind":{"not":{"const":"none"}}}},"then":{"properties":{"sourceRefs":{"minItems":1}}}}]},
    "initiative":{
      "type":"object","additionalProperties":false,"required":["id","appRef","ownerRole","kind","status","hypothesis","approvedCost","metric","stopRule","result","links","exception"],
      "properties":{"id":{"$ref":"#/$defs/ref"},"appRef":{"$ref":"#/$defs/ref"},"ownerRole":{"$ref":"#/$defs/ref"},"kind":{"enum":["source_reconciliation","offer","listing","monetization","acquisition","new_app","research","polish"]},"status":{"enum":["proposed","blocked","deferred","ready_for_review","running","completed","stopped"]},"hypothesis":{"$ref":"#/$defs/text"},"approvedCost":{"$ref":"#/$defs/cost"},"metric":{"$ref":"#/$defs/metric"},"stopRule":{"$ref":"#/$defs/text"},"result":{"$ref":"#/$defs/result"},"links":{"$ref":"#/$defs/links"},"exception":{"$ref":"#/$defs/exception"}},
      "allOf":[{"if":{"properties":{"status":{"const":"running"}}},"then":{"properties":{"approvedCost":{"properties":{"approvalRef":{"$ref":"#/$defs/ref"},"cashCeilingMinor":{"type":"integer"},"currency":{"$ref":"#/$defs/currency"},"computeMinutes":{"type":"integer"}}},"metric":{"properties":{"sourceRef":{"$ref":"#/$defs/ref"},"windowStart":{"type":"string","format":"date"},"windowEnd":{"type":"string","format":"date"}}}}}}]
    },
    "lesson":{
      "type":"object","additionalProperties":false,"required":["id","revision","initiativeRef","state","sourceRefs","observedAt","reviewerRole","reviewReceiptRef","reviewedAt","expiresAt","supersedes","summary"],
      "properties":{"id":{"$ref":"#/$defs/ref"},"revision":{"type":"integer","minimum":1},"initiativeRef":{"$ref":"#/$defs/ref"},"state":{"enum":["proposed","reviewed","rejected","superseded"]},"sourceRefs":{"$ref":"#/$defs/refs"},"observedAt":{"$ref":"#/$defs/nullableTime"},"reviewerRole":{"$ref":"#/$defs/ref"},"reviewReceiptRef":{"$ref":"#/$defs/nullableRef"},"reviewedAt":{"$ref":"#/$defs/nullableTime"},"expiresAt":{"$ref":"#/$defs/nullableTime"},"supersedes":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}@[1-9][0-9]*$"},"summary":{"$ref":"#/$defs/text"}},
      "allOf":[{"if":{"properties":{"state":{"const":"reviewed"}}},"then":{"properties":{"sourceRefs":{"minItems":1},"observedAt":{"type":"string","format":"date-time"},"reviewReceiptRef":{"$ref":"#/$defs/ref"},"reviewedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"}}}}]
    }
  }
}
