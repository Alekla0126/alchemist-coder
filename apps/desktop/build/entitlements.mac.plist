<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults (https://github.com/electron/electron-notarize#prerequisites). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Ad hoc signing with the hardened runtime needs it (electron-builder#3940). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The composer's microphone: the hardened runtime blocks audio input without it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
