{
  "name": "@alchemist-coder/desktop",
  "productName": "Alchemist Coder",
  "version": "0.1.1",
  "private": true,
  "description": "The lab for your coding agents",
  "license": "AGPL-3.0-only",
  "author": "The Alchemist Code",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "capture": "electron-vite build && electron . --capture=../../.captures/app.png",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "rebuild:native": "electron-rebuild -f -w node-pty -m ../..",
    "postinstall": "electron-rebuild -f -w node-pty -m ../.. || echo \"node-pty rebuild failed: the terminal will be unavailable\"",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@alchemist-coder/archive": "workspace:*",
    "@alchemist-coder/arena": "workspace:*",
    "@alchemist-coder/core": "workspace:*",
    "@alchemist-coder/extensions": "workspace:*",
    "@alchemist-coder/harness": "workspace:*",
    "@alchemist-coder/indexer": "workspace:*",
    "@alchemist-coder/providers-local": "workspace:*",
    "@alchemist-coder/themes": "workspace:*",
    "@electron/rebuild": "4.2.0",
    "@shikijs/monaco": "4.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "mermaid": "12.0.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "vite": "7.3.6",
    "zustand": "5.0.15"
  },
  "homepage": "https://coder.alekla.com",
  "desktopName": "alchemist-coder.desktop",
  "repository": "https://github.com/Alekla0126/alchemist-coder"
}
